rules_version = '2';

// Photos rangées par AO : /organisations/{orgId}/photos/{aoId}/{fichier}
// Même logique que Firestore : seule une personne rattachée à l'organisation
// (via son document /users/{uid}) peut lire/écrire ces fichiers.

service firebase.storage {
  match /b/{bucket}/o {

    match /organisations/{orgId}/{allPaths=**} {
      allow read, write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.orgId == orgId;
    }
  }
}
